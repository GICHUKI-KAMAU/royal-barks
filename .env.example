# Gmail SMTP. Create a Google App Password and put it in the ignored local .env file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gichukikamau01@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Royal Barks <gichukikamau01@gmail.com>
APP_BASE_URL=http://127.0.0.1:5173

# Frontend requests use a same-origin /api reverse proxy by default.
# For local Vite development, this controls the /api proxy destination.
API_PROXY_TARGET=http://127.0.0.1:8001
# Set to the HTTPS API URL when the frontend and API are hosted separately.
# Cross-origin production sessions require CORS and SameSite=None cookies.
VITE_API_BASE_URL=/api

# Optional PostgreSQL connection. When set, the API uses PostgreSQL instead of
# the local SQLite file. Use the Supabase session pooler connection string on
# a persistent Node host. Never use this server-only URL in a VITE_ variable.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
# DATABASE_SSL=true
# SESSION_COOKIE_SAME_SITE=None
# CORS_ALLOWED_ORIGINS=https://your-frontend.example

# Set only for a trusted HTTPS deployment. The session cookie is Secure in production.
# NODE_ENV=production
# Optional overrides when running locally:
# PORT=8001
# ROYAL_BARKS_DB=D:/private-data/royal_barks.sqlite3

